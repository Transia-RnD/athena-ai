# Atlas http-* sync targets (opt-in). Set ATHENA_ATLAS_SYNC_TARGETS to include
# e.g. http-atlas:http://localhost:9000/v1/plugins/atlas/webhook to POST the
# rendered atlas markdown to a remote webhook on sync/scan/teach.
# ATLAS_WEBHOOK_SECRET signs the payload (HMAC-SHA256, X-Atlas-Signature);
# empty disables http pushes. ATLAS_SYNC_USER_ID is sent as the body userId.
ATLAS_WEBHOOK_SECRET=
ATLAS_SYNC_USER_ID=